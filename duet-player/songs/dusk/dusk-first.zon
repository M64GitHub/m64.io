// XIV.a THE SLOT + THE VOICE — DUSK's first corpus file.
//
// Two slots on the BUILT-IN morph table (no sample bank needed — the
// saw-solo law's floor). DUSK1 walks K01 (AFTERGLOW: morph 0 = the
// saw, ADSR 00F6) so the ~204 ms release tails SING UNDER the next
// note — the note-instance pool is the audible fact — then `===` lets
// one ring and `^^^` proves the cut beats a tail. DUSK2 pads on K02,
// dialed here to the pulse>sine half of the table (morph 65%), a real
// pad ADSR (A9C6: 500 ms swell, the 204 ms tail completing inside the
// render) and LEVEL 48 — every letter-a knob on the wire at once.
//
// The file is `.version = 4` on purpose: a pre-XIV build REFUSES it
// with "written by a newer DUET (file v4, this build reads v3)" —
// A40's gate, and the refusal IS this file's A/B.
.{
    .version = 4,
    .name = "xiv.a dusk first",
    .it = "dusk-first.it",
    .dusk = .{
        .slots = .{
            .{ .slot = 1 },
            .{ .slot = 2, .patch = 2 },
        },
        .patches = .{
            .{
                .idx = 2,
                .name = "HALF LIGHT",
                .morph = 0.65,
                .adsr = 0xA9C6,
                .amp = 48,
            },
        },
    },
}
